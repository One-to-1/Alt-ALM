# Credentials — never commit.
# NOTE: a leading "./" makes a gitignore pattern match nothing. Do not reintroduce it.
Secrets/
*.env
.env
.env.*
!.env.example

# Generator run manifests / captured output
run-manifests/
*.manifest.json

# Dependencies & build output
node_modules/
dist/
build/
out/
.venv/
venv/
__pycache__/
*.py[cod]

# Java / Maven build output. The Maven wrapper (mvnw, mvnw.cmd, .mvn/wrapper/) IS committed
# on purpose - it is what lets the build run without a local Maven install.
target/
*.class
!.mvn/wrapper/maven-wrapper.properties

# Tooling caches
.cache/
coverage/
.pytest_cache/
.mypy_cache/
.ruff_cache/
playwright-report/
test-results/

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# TD clients (OTA/COM installers — large binaries, machine-local)
TDConnect/

# graphify derived output (regenerate with: graphify update .)
graphify-out/
